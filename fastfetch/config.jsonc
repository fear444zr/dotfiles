{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
	"type": "file",
	"source": "~/.config/fastfetch/logo.txt"
  },
  "modules": [
    "title",
    "separator",
    {
        "type": "os",
        "key": "os",
        "format": "I use Arch btw"
    },
    {
	"type": "host",
	"key": "hardware",
	"format": "Framework 16"
    },
    {
	"type": "uptime",
	"key": "uptime"
    },
    {
	"type" : "wm",
	"key" : "wm",
	"format" : "Hyprland (Wayland)"
    },
    {
        "type" : "terminal",
	"key" : "cli"
    },
    "cpu",
    "gpu",
    "memory"
  ]
}
